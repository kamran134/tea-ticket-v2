# ── Deployment (server .env, not committed) ──────────────────────────────────

# Domain — used for CORS and documentation; nginx is configured separately on the host
DOMAIN=tea-ticket.com
CORS_ORIGIN=https://tea-ticket.com

# Host paths (outside Docker)
DEPLOY_PATH=/opt/tea-ticket-v2
UPLOADS_PATH=/opt/tea-ticket-v2/uploads

# Ports exposed on localhost (nginx proxies to these)
BACKEND_PORT=3001
FRONTEND_PORT=8080
POSTGRES_PORT=5432

# Docker image tags (override when pulling from registry instead of building locally)
# BACKEND_IMAGE=ghcr.io/owner/repo/backend:latest
# FRONTEND_IMAGE=ghcr.io/owner/repo/frontend:latest

# ── Database ─────────────────────────────────────────────────────────────────

POSTGRES_VERSION=17
POSTGRES_DB=teaticket
POSTGRES_USER=teaticket
POSTGRES_PASSWORD=changeme_strong_password

# ── Backend secrets ──────────────────────────────────────────────────────────

JWT_SECRET=change-this-to-a-long-random-secret
# Generate: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# ── Payment acquiring ────────────────────────────────────────────────────────

# mock — local mock provider with hosted page (default for development)
# kapital — Kapital Bank TXPG e-commerce gateway (Birbank). Docs: pg.kapitalbank.az/docs
PAYMENT_PROVIDER=kapital
PAYMENT_HOLD_MINUTES=15
# Overrides minutes when set (local testing: 10)
PAYMENT_HOLD_SECONDS=10
# Preferred TTL knobs (seconds). Production default is 900 if unset.
# Test environments should set these to a short value (e.g. 30) — never hardcode
# test TTLs in business logic.
# BOOKING_TTL_SECONDS=900
# PAYMENT_TTL_SECONDS=900
# TEST_MODE=true enables POST /api/test/reset and /api/test/seed. Never enable in production.
# TEST_MODE=false
PUBLIC_APP_URL=http://localhost:3001
PUBLIC_FRONTEND_URL=http://localhost:5173
PAYMENT_WEBHOOK_BASE_URL=http://backend:3000
MOCK_WEBHOOK_SECRET=change-me-mock-webhook-secret

# Kapital Bank TXPG (Basic auth). Test values below are the bank's own published
# sandbox credentials (pg.kapitalbank.az/docs), not a secret — replace for production.
KAPITAL_API_BASE_URL=https://txpgtst.kapitalbank.az/api
KAPITAL_USERNAME=TerminalSys/kapital
KAPITAL_PASSWORD=kapital123
# KAPITAL_ORDER_TYPE=Order_SMS
# KAPITAL_LANGUAGE=az
# KAPITAL_TIMEOUT_MS=15000

# ── Transactional ticket email (Resend) ─────────────────────────────────────
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=TeaTicket <no-reply@tea-ticket.com>
EMAIL_REPLY_TO=support@tea-ticket.com
EMAIL_MAX_ATTEMPTS=5

# ── Incoming email forwarding (Telegram) ─────────────────────────────────────
# Signing secret for the webhook configured specifically for /api/resend/inbound
RESEND_RECEIVING_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Local development only ───────────────────────────────────────────────────

# DATABASE_URL=postgresql://teaticket:changeme_strong_password@localhost:5432/teaticket
# PORT=3000
# VITE_API_URL=http://localhost:3001

# ── Optional: S3-compatible storage (not used — files stored on disk) ─────────

# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_BUCKET=tea-ticket-receipts
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_PUBLIC_URL=https://tea-ticket-receipts.fsn1.your-objectstorage.com
# Frontend (leave empty in production — uses relative URLs /api/...)
VITE_API_URL=

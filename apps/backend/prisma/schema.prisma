generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  BOOKED
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REQUIRES_REVIEW
}

enum ConfirmationSource {
  PAYMENT
  MANUAL
}

enum ZoneType {
  GENERAL
  SEATED
  TABLE
}

enum TableShape {
  ROUND
  RECT
}

model Venue {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  date           DateTime
  active         Boolean  @default(true)
  currency       String   @default("₼")
  floorPlanImage String?
  posterImage    String?
  gridLayout     Json?
  createdAt      DateTime @default(now())
  zones          Zone[]
  tickets        Ticket[]
}

model GridTemplate {
  id        String   @id @default(cuid())
  name      String
  rows      Int
  cols      Int
  cells     Json
  zones     Json
  createdAt DateTime @default(now())
}

model Zone {
  id         String    @id @default(cuid())
  venueId    String
  name       String
  price      Float
  cardNumber String    @default("")
  capacity   Int
  sortOrder  Int       @default(0)
  type       ZoneType  @default(GENERAL)
  color      String?
  layoutData Json?
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  seats      Seat[]
  tables     ZoneTable[]
}

model Seat {
  id           String  @id @default(cuid())
  zoneId       String
  number       Int
  row          Int
  sectionIndex Int     @default(0)
  posInSection Int
  label        String?
  zone         Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  ticket       Ticket?

  @@unique([zoneId, number])
  @@unique([zoneId, row, sectionIndex, posInSection])
  @@index([zoneId])
}

model ZoneTable {
  id         String     @id @default(cuid())
  zoneId     String
  number     Int
  shape      TableShape @default(ROUND)
  chairCount Int
  layoutData Json?
  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@unique([zoneId, number])
  @@index([zoneId])
}

model Ticket {
  id                 String              @id @default(cuid())
  name               String
  phone              String
  venueId            String
  zoneId             String
  zoneName           String
  cardNumber         String
  price              Float
  receiptLink        String?
  status             TicketStatus        @default(BOOKED)
  checkedIn          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  bookedAt           DateTime            @default(now())
  expiresAt          DateTime?
  groupId            String?
  seatId             String?             @unique
  tableId            String?
  confirmationSource ConfirmationSource?
  confirmedAt        DateTime?
  confirmationNote   String?
  venue              Venue               @relation(fields: [venueId], references: [id])
  zone               Zone                @relation(fields: [zoneId], references: [id])
  seat               Seat?               @relation(fields: [seatId], references: [id])
  table              ZoneTable?          @relation(fields: [tableId], references: [id])

  @@index([groupId])
  @@index([status])
  @@index([venueId, status])
  @@index([expiresAt])
}

model Payment {
  id                String              @id @default(cuid())
  checkoutId        String
  provider          String
  providerPaymentId String?             @unique
  idempotencyKey    String              @unique
  amount            Decimal             @db.Decimal(18, 4)
  status            PaymentStatus       @default(CREATED)
  redirectUrl       String?
  returnToken       String              @unique @default(cuid())
  expiresAt         DateTime?
  paidAt            DateTime?
  failureCode       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  webhookEvents     PaymentWebhookEvent[]

  @@index([checkoutId])
  @@index([checkoutId, status])
  @@index([status])
  @@index([expiresAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  paymentId       String?
  provider        String
  providerEventId String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  BOOKED
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REQUIRES_REVIEW
}

enum ConfirmationSource {
  PAYMENT
  MANUAL
}

enum ZoneType {
  GENERAL
  SEATED
  TABLE
}

enum TableShape {
  ROUND
  RECT
  SOFA
}

// ── Admin accounts, roles and permissions ────────────────────────────────────
// Permission codes live in src/services/permissions.ts, not in a table: every
// code is referenced literally by a route's requirePermission(), so the catalog
// is inherently code-coupled and a separate table would only add a way for the
// two to drift apart.

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  roleId       String
  active       Boolean         @default(true)
  // Bumped on logout, password change and deactivation — invalidates every
  // token issued so far without needing a session table.
  tokenVersion Int             @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  role         AdminRole       @relation(fields: [roleId], references: [id])
  auditLogs    AdminAuditLog[]
  venues       Venue[]

  @@index([roleId])
}

model AdminRole {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String?
  permissions  String[]
  isSystem     Boolean     @default(false)
  // The super admin role bypasses the permission list entirely and its own
  // permissions can never be edited.
  isSuperAdmin Boolean     @default(false)
  createdAt    DateTime    @default(now())
  users        AdminUser[]
}

model AdminAuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  // Denormalised so the trail survives deletion of the account that acted.
  actorEmail String
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model Venue {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  date           DateTime
  active         Boolean    @default(true)
  currency       String     @default("₼")
  floorPlanImage String?
  posterImage    String?
  description    String?
  gridLayout     Json?
  createdAt      DateTime   @default(now())
  createdById    String?
  createdBy      AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  zones          Zone[]
  tickets        Ticket[]

  @@index([createdById])
}

model GridTemplate {
  id        String   @id @default(cuid())
  name      String
  rows      Int
  cols      Int
  cells     Json
  zones     Json
  createdAt DateTime @default(now())
}

model Zone {
  id          String      @id @default(cuid())
  venueId     String
  name        String
  price       Float
  capacity    Int
  sortOrder   Int         @default(0)
  type        ZoneType    @default(GENERAL)
  color       String?
  tableChairs Int?
  tableShape  TableShape?
  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  seats       Seat[]
  tables      ZoneTable[]
}

model Seat {
  id           String     @id @default(cuid())
  zoneId       String
  tableId      String?
  number       Int
  row          Int
  sectionIndex Int        @default(0)
  posInSection Int
  zone         Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  table        ZoneTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([zoneId, number])
  @@unique([zoneId, row, sectionIndex, posInSection])
  @@index([zoneId])
  @@index([tableId])
}

model ZoneTable {
  id         String     @id @default(cuid())
  zoneId     String
  number     Int
  shape      TableShape @default(ROUND)
  chairCount Int
  row        Int?
  col        Int?
  rows       Int?
  cols       Int?
  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  seats      Seat[]

  @@unique([zoneId, number])
  @@index([zoneId])
}

model Ticket {
  id                 String              @id @default(cuid())
  name               String
  phone              String
  email              String?
  venueId            String
  zoneId             String
  zoneName           String
  price              Float
  receiptLink        String?
  status             TicketStatus        @default(BOOKED)
  checkedIn          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  bookedAt           DateTime            @default(now())
  expiresAt          DateTime?
  groupId            String?
  // Uniqueness for live bookings is a partial unique index in SQL
  // (Ticket_seatId_active_key): BOOKED/PENDING/CONFIRMED only. Expired and
  // rejected tickets keep seatId for history without blocking resale.
  seatId             String?
  tableId            String?
  confirmationSource ConfirmationSource?
  confirmedAt        DateTime?
  confirmationNote   String?
  venue              Venue               @relation(fields: [venueId], references: [id])
  zone               Zone                @relation(fields: [zoneId], references: [id])
  seat               Seat?               @relation(fields: [seatId], references: [id], onDelete: SetNull)
  table              ZoneTable?          @relation(fields: [tableId], references: [id])

  @@index([groupId])
  @@index([status])
  @@index([venueId, status])
  @@index([expiresAt])
  @@index([seatId])
}

model Payment {
  id                String              @id @default(cuid())
  checkoutId        String
  provider          String
  providerPaymentId String?             @unique
  idempotencyKey    String              @unique
  amount            Decimal             @db.Decimal(18, 4)
  status            PaymentStatus       @default(CREATED)
  redirectUrl       String?
  returnToken       String              @unique @default(cuid())
  expiresAt         DateTime?
  paidAt            DateTime?
  failureCode       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  webhookEvents     PaymentWebhookEvent[]

  @@index([checkoutId])
  @@index([checkoutId, status])
  @@index([status])
  @@index([expiresAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  paymentId       String?
  provider        String
  providerEventId String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
}

enum EmailJobType {
  TICKET_CONFIRMED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  ACCEPTED
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

model EmailJob {
  id                String         @id @default(cuid())
  type              EmailJobType
  status            EmailJobStatus @default(PENDING)
  checkoutId        String
  recipient         String
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now())
  lockedAt          DateTime?
  providerMessageId String?        @unique
  lastError         String?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([type, checkoutId])
  @@index([status, nextAttemptAt])
  @@index([lockedAt])
}

model EmailWebhookEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  type            String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([type])
}

// Inbound support/reply-to emails: only provider id + read flag — no body or metadata.
model InboundEmail {
  id              String   @id @default(cuid())
  providerEmailId String   @unique
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([isRead])
}

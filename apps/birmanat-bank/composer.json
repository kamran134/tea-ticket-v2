{
  "name": "tea-ticket/birmanat-bank",
  "description": "BirManatBank payment simulator (hosted page + REST API)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "BirManatBank\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BirManatBank\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
